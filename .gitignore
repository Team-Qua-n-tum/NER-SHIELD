# ------------------------------------------------------------

node_modules/
.npm/
.pnpm-store/
.yarn/
.yarn-cache/

.next/
out/
dist/
build/

*.tsbuildinfo

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------
# Python
# ------------------------------------------------------------

__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/

pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.eggs/
MANIFEST

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

