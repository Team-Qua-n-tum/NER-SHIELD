# Copy to .env for local development. Never commit the populated file.

APP_NAME=NER-SHIELD
APP_ENV=development
APP_VERSION=1.0.0

API_HOST=0.0.0.0
API_PORT=8000
DEMO_MODE=true

# Browser-safe frontend settings are read from frontend/.env.
VITE_API_URL=http://localhost:8000/api/v1
VITE_DEMO_MODE=true
VITE_MAP_PROVIDER=openstreetmap
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Required only when DEMO_MODE=false.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nershield
POSTGRES_DB=nershield
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
WEATHER_API_URL=
WEATHER_API_KEY=
ROUTING_API_URL=
ROUTING_API_KEY=

# Comma-separated browser origins. Do not use * with credentials.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:80

# Optional live notification credentials; never place service-account JSON in git.
FIREBASE_CREDENTIALS_FILE=
FIREBASE_CREDENTIALS_JSON=

MODEL_PATH=backend/ai/models/disruption_model.joblib
MODEL_VERSION=prototype-v1
DEPLOYMENT_ENV=local
