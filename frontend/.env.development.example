# NER-SHIELD Frontend Development Environment
# Copy to .env.development or .env.local for local development

# Set to true to enable explicit local demo mode with instant role switching
VITE_DEMO_MODE=true

# Backend API Base URL
VITE_API_URL=http://localhost:8000/api/v1

# Firebase configuration (optional for local demo)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
